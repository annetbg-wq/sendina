# Local UI/API. Railway sets PORT itself.
PORT=3001
# Bind address. Loopback locally; Railway switches to 0.0.0.0 on its own.
HOST=127.0.0.1
# Platform secret. Required before the server will listen on any public address.
# It no longer signs anyone in: people use accounts and login links.
APP_TOKEN=
# PostgreSQL. Without this, local data/state.json is used and a redeploy loses data.
DATABASE_URL=
ALLOWED_ORIGINS=https://annetbg-wq.github.io
# Public address of this service. Used for the MCP endpoint and OAuth metadata.
PUBLIC_URL=https://sendina-production.up.railway.app
# Where the interface lives. This is where the login callback sends a person once
# they are signed in. The link in the mail itself always addresses PUBLIC_URL,
# because /auth/callback is a route on this server: a static host such as GitHub
# Pages has no such path and answers it with a 404.
APP_URL=https://annetbg-wq.github.io/sendina/

# --- Accounts -------------------------------------------------------------
# Extra superadmins beyond the three built in. Comma separated.
SUPERADMINS=
# How long a session lasts.
SESSION_DAYS=30

# --- Platform mail --------------------------------------------------------
# Sends login links and approval notices. Without it nobody but a superadmin
# can sign in, and a superadmin has to read the link from the server log.
# The three required ones are HOST, USER and PASS; the state of all five is shown
# on the Accounts screen, which also sends a test message to prove they work.
SYSTEM_SMTP_HOST=
# Optional. 587 (STARTTLS) by default; 465 switches to implicit TLS.
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
# Optional. Defaults to SYSTEM_SMTP_USER.
SYSTEM_MAIL_FROM=

# --- Mailbox check deadlines ----------------------------------------------
# A wrong SMTP or IMAP host accepts the connection and then says nothing, so
# every phase of a mailbox check is bounded and so is the check as a whole. The
# interface always receives a result naming the step that stopped it. Defaults
# are sensible; set these only to trade patience against how long a person waits.
# One phase: an SMTP login, one send, an IMAP connect.
MAIL_PHASE_TIMEOUT_MS=20000
# Reading the test message back, which legitimately waits for delivery.
MAIL_READBACK_TIMEOUT_MS=45000
# All four phases together. Nothing waits longer than this.
MAIL_VERIFY_TIMEOUT_MS=100000

# --- Sending --------------------------------------------------------------
# Real sending is off unless this says otherwise, because turning it on is not
# reversible for the people who receive the mail. With it unset every other part
# of the product works and the send route refuses, naming this variable.
SENDING_ENABLED=
# The controlled-test fence. While it has entries, a message can only reach one
# of these addresses, whatever the campaign holds and whatever the rules allow —
# it is applied after the policy engine, never instead of it. Comma separated.
# Empty means no fence, which is what a real campaign eventually needs.
SEND_ALLOWLIST=
# Most messages one call may send. Default 25, hard ceiling 200.
SEND_MAX_PER_RUN=25
# Beyond these, sending still needs, per workspace: a mailbox that passed all
# four checks, SPF/DKIM/DMARC on its domain, a daily domain allowance set by
# hand on the mail screen, an active campaign, prepared drafts, and whatever the
# campaign's control mode asks for. None of that is configured here.

# Encrypts mailbox passwords and provider refresh tokens. Without it the server
# generates a key beside the data, which is weaker but never stores anything in the clear.
ENCRYPTION_KEY=

# Model, search, organisation search and mailbox provider keys are not set here.
# A superadmin registers them once on the Accounts screen, for every account at
# once. An account may still bring its own model or search key in its Settings.

# --- MCP ------------------------------------------------------------------
# The built-in OAuth 2.1 server runs automatically when APP_TOKEN is set and
# OAUTH_ISSUER is empty. Set MCP_TOKEN only for a local client without OAuth.
MCP_TOKEN=
MCP_RESOURCE_URL=
# Subject bound to this workspace; issued tokens must carry it.
MCP_SUBJECT=

# Use these two only to delegate OAuth to an external provider instead.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
