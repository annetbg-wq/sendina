# Local UI/API. Railway sets PORT itself.
PORT=3001
# Bind address. Loopback locally; Railway switches to 0.0.0.0 on its own.
HOST=127.0.0.1
# Platform secret. Required before the server will listen on any public address.
# It no longer signs anyone in: people use accounts and login links.
APP_TOKEN=
# PostgreSQL. Without this, local data/state.json is used and a redeploy loses data.
DATABASE_URL=
ALLOWED_ORIGINS=https://annetbg-wq.github.io
# Public address of this service. Used for the MCP endpoint and OAuth metadata.
PUBLIC_URL=https://sendina-production.up.railway.app
# Where the interface lives. Login links point here.
APP_URL=https://annetbg-wq.github.io/sendina/

# --- Accounts -------------------------------------------------------------
# Extra superadmins beyond the three built in. Comma separated.
SUPERADMINS=
# How long a session lasts.
SESSION_DAYS=30

# --- Platform mail --------------------------------------------------------
# Sends login links and approval notices. Without it nobody but a superadmin
# can sign in, and a superadmin has to read the link from the server log.
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_MAIL_FROM=

# Encrypts mailbox passwords and provider refresh tokens. Without it the server
# generates a key beside the data, which is weaker but never stores anything in the clear.
ENCRYPTION_KEY=

# Model, search, organisation search and mailbox provider keys are not set here.
# A superadmin registers them once on the Accounts screen, for every account at
# once. An account may still bring its own model or search key in its Settings.

# --- MCP ------------------------------------------------------------------
# The built-in OAuth 2.1 server runs automatically when APP_TOKEN is set and
# OAUTH_ISSUER is empty. Set MCP_TOKEN only for a local client without OAuth.
MCP_TOKEN=
MCP_RESOURCE_URL=
# Subject bound to this workspace; issued tokens must carry it.
MCP_SUBJECT=

# Use these two only to delegate OAuth to an external provider instead.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
