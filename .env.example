# Local UI/API. Railway sets PORT itself.
PORT=3001
# Bind address. Loopback locally; Railway switches to 0.0.0.0 on its own.
HOST=127.0.0.1
# Protects the UI API and authorises the built-in OAuth consent screen.
# Required before the server will listen on any public address.
APP_TOKEN=
# PostgreSQL. Without this, local data/state.json is used and a redeploy loses data.
DATABASE_URL=
ALLOWED_ORIGINS=https://annetbg-wq.github.io
# Public address of this service. Used for the MCP endpoint and OAuth metadata.
PUBLIC_URL=https://sendina-production.up.railway.app

# --- AI layer -------------------------------------------------------------
# Without a key, "Find recipients" and message preparation refuse to guess.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: route through a gateway that speaks the OpenAI chat completions API.
AI_GATEWAY_URL=

# --- Recipient research ---------------------------------------------------
# With a search key, candidates cite a real result and an address is kept only
# when it occurs in that result. Without one, candidates stay unverified.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- MCP ------------------------------------------------------------------
# The built-in OAuth 2.1 server runs automatically when APP_TOKEN is set and
# OAUTH_ISSUER is empty. Set MCP_TOKEN only for a local client without OAuth.
MCP_TOKEN=
MCP_RESOURCE_URL=
# Subject bound to this workspace; issued tokens must carry it.
MCP_SUBJECT=

# Use these two only to delegate OAuth to an external provider instead.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
