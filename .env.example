# Local UI/API. Railway sets PORT itself.
PORT=3001
# Bind address. Loopback locally; Railway switches to 0.0.0.0 on its own.
HOST=127.0.0.1
# Protects the UI API. Enter this token on the sign-in screen.
# Required before the server will listen on any public address.
APP_TOKEN=
# Optional PostgreSQL. Without this, local data/state.json is used.
DATABASE_URL=
ALLOWED_ORIGINS=https://annetbg-wq.github.io

# Local MCP development only. Use a random secret; never commit it.
MCP_TOKEN=
MCP_RESOURCE_URL=http://127.0.0.1:3001/mcp

# Remote ChatGPT connector: configure a real OAuth 2.1 authorization server.
# It must support PKCE and the ChatGPT client registration workflow.
# Tokens must contain aud=MCP_RESOURCE_URL, exp, sub, scope.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
# This single-workspace version accepts exactly this subject.
MCP_SUBJECT=
