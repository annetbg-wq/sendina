  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "imapflow": "^1.7.8",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
